+static VkResult
+vtest_vcmd_resource_import_blob(struct vtest *vtest,
+                                int fd,
+                                uint32_t *res_id)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE] = {
+      [VTEST_CMD_LEN] = VCMD_RESOURCE_IMPORT_BLOB_SIZE,
+      [VTEST_CMD_ID] = VCMD_RESOURCE_IMPORT_BLOB,
+   };
+   uint32_t resp[2];
+
+   vtest_write(vtest, vtest_hdr, sizeof(vtest_hdr));
+   vtest_send_fd(vtest, fd);
+
+   vtest_read(vtest, vtest_hdr, sizeof(vtest_hdr));
+   assert(vtest_hdr[VTEST_CMD_LEN] == 2);
+   assert(vtest_hdr[VTEST_CMD_ID] == VCMD_RESOURCE_IMPORT_BLOB);
+   vtest_read(vtest, resp, sizeof(resp));
+
+   *res_id = resp[1];
+   return (VkResult)(int32_t)resp[0];
+}
