+static VkResult
+vtest_bo_create_from_dma_buf(struct vn_renderer *renderer,
+                             VkDeviceSize size,
+                             int fd,
+                             VkMemoryPropertyFlags flags,
+                             struct vn_renderer_bo **out_bo)
+{
+   struct vtest *vtest = (struct vtest *)renderer;
+   uint32_t res_id;
+
+   mtx_lock(&vtest->sock_mutex);
+   VkResult result = vtest_vcmd_resource_import_blob(vtest, fd, &res_id);
+   mtx_unlock(&vtest->sock_mutex);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct vtest_bo *bo = util_sparse_array_get(&vtest->bo_array, res_id);
+   if (vn_refcount_is_valid(&bo->base.refcount)) {
+      bo->base.mmap_size = MAX2(bo->base.mmap_size, size);
+      vn_refcount_inc(&bo->base.refcount);
+   } else {
+      const int res_fd = os_dupfd_cloexec(fd);
+      if (res_fd < 0) {
+         mtx_lock(&vtest->sock_mutex);
+         vtest_vcmd_resource_unref(vtest, res_id);
+         mtx_unlock(&vtest->sock_mutex);
+         return VK_ERROR_TOO_MANY_OBJECTS;
+      }
+
+      *bo = (struct vtest_bo){
+         .base = {
+            .refcount = VN_REFCOUNT_INIT(1),
+            .res_id = res_id,
+            .mmap_size = size,
+         },
+         .res_fd = res_fd,
+         .blob_flags = vtest_bo_blob_flags(
+            flags, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT),
+      };
+   }
+   *out_bo = &bo->base;
+
+   return VK_SUCCESS;
+}
